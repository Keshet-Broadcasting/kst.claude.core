{
  "name": "@keshet/app-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && steiger ./src && node scripts/embed-check.mjs",
    "steiger": "steiger ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "embed:add": "node scripts/embed-add.mjs",
    "embed:check": "node scripts/embed-check.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.17.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "steiger": "0.6.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
